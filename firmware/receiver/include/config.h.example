// Copy to config.h and fill in real values. config.h is gitignored.
#pragma once

// 0 = USB mode: receiver stays plugged into the laptop, works on any network (or none).
// Run tools/serial_to_mqtt.py on the laptop. 1 = receiver publishes over WiFi/MQTT itself.
#define HAB_USE_WIFI 0

#define HAB_WIFI_SSID "your-wifi-ssid"
#define HAB_WIFI_PASSWORD "your-wifi-password"

#define HAB_MQTT_HOST "192.168.1.50"  // the machine running docker compose
#define HAB_MQTT_PORT 1883

#define HAB_RECEIVER_ID "gs1"
#define HAB_RECEIVER_LAT 52.5200
#define HAB_RECEIVER_LON 13.4050
#define HAB_RECEIVER_ALT_M 40.0
