            "uid": "influxdb-hab"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -15s)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"snr\")\n  |> group(columns: [\"receiver_id\"])\n  |> last()\n  |> map(fn: (r) => ({r with _value: if float(v: r._value) >= 10.0 then 0.0 else if float(v: r._value) <= -15.0 then 100.0 else (10.0 - float(v: r._value)) / 25.0 * 100.0}))\n  |> keep(columns: [\"receiver_id\", \"_value\"])"
        }
