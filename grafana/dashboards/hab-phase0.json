{
  "id": null,
  "uid": "hab-phase0",
  "title": "HAB Phase 0 - Ground Telemetry",
  "tags": [
    "hab",
    "phase0"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 12,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "bucket",
        "type": "textbox",
        "label": "InfluxDB bucket",
        "query": "telemetry",
        "current": {
          "text": "telemetry",
          "value": "telemetry"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 12,
      "title": "Data feed",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-hab"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-hab"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"rssi\")\n  |> group()\n  |> last()\n  |> map(fn: (r) => ({_value: float(v: uint(v: now()) - uint(v: r._time)) / 1000000000.0}))\n  |> keep(columns: [\"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "NO DATA - check forwarder / receiver / tracker",
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 30,
                "result": {
                  "text": "LIVE",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "valueSize": 28
        }
      },
      "description": "Seconds since the last packet reached InfluxDB. Green 'LIVE' under 30 s; otherwise it shows the age in seconds, and after 10 min with no data it shows NO DATA. If red while the tracker is on: is tools/serial_to_mqtt.py running (USB mode), is the receiver plugged in, is Docker up?",
      "pluginVersion": "11.2.0"
    },
    {
      "id": 1,
      "title": "Geomap: tracker track + receivers",
      "type": "geomap",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-hab"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-hab"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\")\n  |> filter(fn: (r) => r._field == \"lat\" or r._field == \"lon\" or r._field == \"alt_m\")\n  |> filter(fn: (r) => exists r.node_id)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group(columns: [\"node_id\"])\n  |> sort(columns: [\"_time\"])"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-hab"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\")\n  |> filter(fn: (r) => r._field == \"receiver_lat\" or r._field == \"receiver_lon\")\n  |> filter(fn: (r) => exists r.receiver_id)\n  |> group(columns: [\"receiver_id\", \"_field\"])\n  |> last()\n  |> pivot(rowKey: [\"receiver_id\"], columnKey: [\"_field\"], valueColumn: \"_value\")"
        }
      ],
      "options": {
        "view": {
          "id": "zero",
          "lat": 0,
          "lon": 0,
          "zoom": 1
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true
        },
        "basemap": {
          "type": "xyz",
          "name": "Basemap",
          "config": {
            "url": "http://localhost:8080/{z}/{x}/{y}.png",
            "attribution": "\u00a9 OpenStreetMap contributors (cached locally)"
          }
        },
        "layers": [
          {
            "type": "markers",
            "name": "Tracker track",
            "location": {
              "mode": "auto"
            },
            "filterData": {
              "id": "byRefId",
              "options": "A"
            },
            "config": {
              "style": {
                "color": {
                  "fixed": "red"
                },
                "size": {
                  "fixed": 5
                }
              }
            }
          },
          {
            "type": "markers",
            "name": "Receiver(s)",
            "location": {
              "mode": "auto"
            },
            "filterData": {
              "id": "byRefId",
              "options": "B"
            },
            "config": {
              "style": {
                "color": {
                  "fixed": "blue"
                },
                "size": {
                  "fixed": 9
                }
              }
            }
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
