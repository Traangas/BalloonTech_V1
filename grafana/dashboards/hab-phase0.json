    {
      "id": 9,
      "title": "Signal strength",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-hab"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-hab"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -15s)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"rssi\")\n  |> group(columns: [\"receiver_id\"])\n  |> last()\n  |> map(fn: (r) => ({r with _value: if float(v: r._value) >= -50.0 then 100.0 else if float(v: r._value) <= -130.0 then 0.0 else (float(v: r._value) + 130.0) / 80.0 * 100.0}))\n  |> keep(columns: [\"receiver_id\", \"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "noValue": "No link",
          "color": {
            "mode": "continuous-RdYlGr"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": false,
        "orientation": "auto",
        "text": {
          "valueSize": 28,
          "titleSize": 14
        }
      },
      "description": "Latest RSSI mapped linearly: -130 dBm = 0%, -50 dBm = 100%. Uses only packets from the last 15 s (kLinkTimeoutMs); with no recent packet it shows 'No link'.",
      "pluginVersion": "11.2.0"
    },
    {
      "id": 10,
      "title": "Tracker battery",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 28
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-hab"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-hab"
          },
          "query": "import \"math\"\nfrom(bucket: \"${bucket}\")\n  |> range(start: -15s)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"batt_mv\")\n  |> group(columns: [\"node_id\"])\n  |> last()\n  |> map(fn: (r) => ({r with volts: string(v: math.round(x: float(v: r._value) / 10.0) / 100.0), _value: if float(v: r._value) >= 4200.0 then 100.0 else if float(v: r._value) <= 3300.0 then 0.0 else (float(v: r._value) - 3300.0) / 900.0 * 100.0}))\n  |> keep(columns: [\"node_id\", \"volts\", \"_value\"])\n  |> group(columns: [\"node_id\", \"volts\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "noValue": "No link",
          "color": {
            "mode": "continuous-RdYlGr"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          },
          "displayName": "${__field.labels.volts} V"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": false,
        "orientation": "auto",
        "text": {
          "valueSize": 28,
          "titleSize": 14
        }
      },
      "description": "Battery % from batt_mv, linear 3.3 V = 0% to 4.2 V = 100% (same approximation as the tracker OLED). Voltage shown under the value. Older tracker firmware reported a hard-coded 4100 mV placeholder.",
      "pluginVersion": "11.2.0"
    },
    {
      "id": 11,
      "title": "Noise",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-hab"
      },
