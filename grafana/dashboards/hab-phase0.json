        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Battery voltage and internal temperature",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 17
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-hab"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-hab"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and (r._field == \"batt_mv\" or r._field == \"temp_c\"))\n  |> group(columns: [\"node_id\", \"_field\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": []
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*batt_mv.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "mvolt"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*temp_c.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Status: last packet, fix, sats, flags, reboots",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 17
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-hab"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-hab"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"telemetry\")\n  |> filter(fn: (r) => r._field == \"fix\" or r._field == \"sats\" or r._field == \"airborne_mode\" or r._field == \"rebooted\" or r._field == \"seq\")\n  |> filter(fn: (r) => exists r.node_id)\n  |> group(columns: [\"node_id\", \"_field\"])\n  |> last()\n  |> drop(columns: [\"_start\", \"_stop\"])\n  |> pivot(rowKey: [\"node_id\", \"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> rename(columns: {_time: \"last_seen\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "last_seen"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
