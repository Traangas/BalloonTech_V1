          "color": {
            "mode": "continuous-GrYlRd"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": false,
        "orientation": "auto",
        "text": {
          "valueSize": 28,
          "titleSize": 14
        }
      },
      "description": "Noise derived from SNR: SNR >= +10 dB = 0% (clean), SNR <= -15 dB = 100% (at/below the SF9 decode limit). Uses packets from the last 15 s.",
      "pluginVersion": "11.2.0"
    }
  ]
