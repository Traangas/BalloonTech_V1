      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 20
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-hab"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
