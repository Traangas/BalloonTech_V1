    {
      "id": 7,
      "title": "Status: last packet, fix, sats, flags, reboots",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 20
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-hab"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-hab"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"telemetry\")\n  |> filter(fn: (r) => r._field == \"fix\" or r._field == \"sats\" or r._field == \"airborne_mode\" or r._field == \"rebooted\" or r._field == \"seq\")\n  |> filter(fn: (r) => exists r.node_id)\n  |> group(columns: [\"node_id\", \"_field\"])\n  |> last()\n  |> drop(columns: [\"_start\", \"_stop\"])\n  |> pivot(rowKey: [\"node_id\", \"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> rename(columns: {_time: \"last_seen\"})"
        }
