# Copy to .env and set real values before `docker compose up`.

# InfluxDB 2.x init (only used on first boot / empty volume)
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=changeme123
INFLUXDB_INIT_ORG=hab
INFLUXDB_INIT_BUCKET=telemetry
INFLUXDB_INIT_ADMIN_TOKEN=changeme-super-secret-admin-token
INFLUXDB_INIT_RETENTION=0

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme123

# Bridge
BRIDGE_LOG_LEVEL=INFO
